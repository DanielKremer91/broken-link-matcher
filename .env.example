# Kopiere diese Datei nach .env und trage deine Werte ein: cp .env.example .env && chmod 600 .env
# .env steht in .gitignore und landet nie im Repo. Werte aus der Shell haben Vorrang.

# Embeddings und Mail-Entwürfe (passend zu embedding.provider in monitor.config.json)
OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Versand per Resend (nur bei mail.method = "resend")
RESEND_API_KEY=
# Absender auf einer in Resend verifizierten Domain
RESEND_FROM=Broken Link Monitor <monitor@deine-domain.de>
